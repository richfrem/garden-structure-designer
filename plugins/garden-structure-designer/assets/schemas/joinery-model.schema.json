{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "joinery-model",
  "type": "object",
  "required": [
    "schema",
    "connections"
  ],
  "properties": {
    "schema": {
      "type": "string"
    },
    "source_hash": {
      "type": "string"
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "node",
          "type",
          "fasteners"
        ],
        "properties": {
          "node": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "fasteners": {
            "type": "string"
          }
        }
      }
    }
  }
}