{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "design-spec",
  "type": "object",
  "required": [
    "structureType",
    "planShape",
    "jurisdiction"
  ],
  "properties": {
    "schema": { "type": "string" },
    "source_hash": { "type": "string" },
    "structureType": {
      "type": "string",
      "description": "e.g. pergola, gazebo, pavilion"
    },
    "planShape": {
      "type": "string",
      "description": "e.g. hexagon, square, octagon, rectangular"
    },
    "jurisdiction": {
      "type": "string",
      "description": "e.g. BC-Coastal, BC-Interior, Unknown"
    },
    "pitch": { "type": "string" },
    "pitchDefaulted": { "type": "boolean" },
    "span_ft": { "type": "number" },
    "heightConstraints": {
      "type": "object",
      "properties": {
        "totalHeightLimit_ft": { "type": "number" }
      }
    },
    "joinery_preference": {
      "type": "string",
      "enum": ["mechanical", "timber", "TBD"]
    }
  },
  "additionalProperties": true
}