{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "bracing-model",
  "type": "object",
  "required": [
    "schema",
    "braces"
  ],
  "properties": {
    "schema": {
      "type": "string"
    },
    "source_hash": {
      "type": "string"
    },
    "braces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "quantity",
          "constraints"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "quantity": {
            "type": "integer"
          },
          "length_in": {
            "type": "number",
            "description": "Derived output from geometry_engine. Not a required input in the constraint-based architecture."
          },
          "constraints": {
            "type": "object",
            "required": [
              "start_surface",
              "end_surface"
            ],
            "properties": {
              "start_surface": {
                "type": "string"
              },
              "end_surface": {
                "type": "string"
              },
              "run_ft": {
                "type": "number",
                "description": "Horizontal run in feet. Derived by cad_language_translator from bracing geometry."
              }
            }
          }
        }
      }
    }
  }
}
