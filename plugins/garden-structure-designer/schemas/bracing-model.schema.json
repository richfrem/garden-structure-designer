{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "bracing-model",
  "type": "object",
  "required": [
    "schema",
    "braces"
  ],
  "properties": {
    "schema": {
      "type": "string"
    },
    "source_hash": {
      "type": "string"
    },
    "braces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "quantity",
          "length_in"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "quantity": {
            "type": "integer"
          },
          "length_in": {
            "type": "number"
          }
        }
      }
    }
  }
}